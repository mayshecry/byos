# Limine bootloader configuration -- generated by `make` from limine.conf.in
# Values in @PLACEHOLDERS@ come from config.mk. Edit config.mk, not the
# generated limine.conf.
timeout: @BOOT_TIMEOUT@
default_entry: 1
graphics: yes
verbose: yes
interface_resolution: @BOOT_RESOLUTION@

/@OS_NAME@
    protocol: multiboot1
    kernel_path: boot():/boot/@OS_NAME_LOWER@.bin

/@OS_NAME@ Lite
    comment: Text console only (no desktop)
    protocol: multiboot1
    kernel_path: boot():/boot/@OS_NAME_LOWER@.bin
    cmdline: lite
