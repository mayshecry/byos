# GRUB configuration -- generated by `make` from grub.cfg.in
# Values in @PLACEHOLDERS@ come from config.mk. Edit config.mk, not the
# generated grub.cfg. (Only needed if you boot with GRUB instead of Limine.)
insmod all_video

set timeout=@BOOT_TIMEOUT@
set default=0
set gfxmode=1920x1080x32,1280x720x32,1024x768x32,auto
set gfxpayload=keep

menuentry "@OS_NAME@" {
    multiboot /boot/@OS_NAME_LOWER@.bin
}

menuentry "@OS_NAME@ Lite" {
    multiboot /boot/@OS_NAME_LOWER@.bin lite
}
