# =============================================================================
#  Makefile -- configurable build for the kernel + desktop base
# =============================================================================
#  All naming/branding lives in config.mk (OS_NAME, OS_VERSION, ...).
#  This Makefile turns those values into:
#     * build/generated/os_config.h   (C macros used across the kernel)
#     * build/limine.conf             (bootloader menu, from limine.conf.in)
#     * build/grub.cfg                (optional GRUB menu, from grub.cfg.in)
#     * build/<name>.bin              (the kernel image)
#     * build/<name>.ISO              (bootable ISO, BIOS + UEFI via Limine)
#
#  Common targets:  make            -> build the ISO
#                   make kernel     -> kernel image only
#                   make run        -> build ISO and boot it in QEMU
#                   make run-serial -> boot with serial console, no window
#                   make clean      -> remove build/
#                   make config     -> show the active configuration
#                   make verify     -> branding/credit sanity checks
#                   make help       -> list targets
#
#  Kernel originally created by mayshecry.
# =============================================================================

include config.mk

# Values in config.mk may have trailing spaces before their comments; strip
# them so they never leak into generated strings or file names.
OS_NAME         := $(strip $(OS_NAME))
OS_NAME_LOWER   := $(strip $(OS_NAME_LOWER))
OS_VERSION      := $(strip $(OS_VERSION))
OS_CODENAME     := $(strip $(OS_CODENAME))
OS_VENDOR       := $(strip $(OS_VENDOR))
OS_HOSTNAME     := $(strip $(OS_HOSTNAME))
OS_DEFAULT_USER := $(strip $(OS_DEFAULT_USER))
OS_SHELL_NAME   := $(strip $(OS_SHELL_NAME))
KERNEL_AUTHOR   := $(strip $(KERNEL_AUTHOR))
BOOT_TIMEOUT    := $(strip $(BOOT_TIMEOUT))
BOOT_RESOLUTION := $(strip $(BOOT_RESOLUTION))
WALLPAPER_TOP   := $(strip $(WALLPAPER_TOP))
WALLPAPER_BOTTOM:= $(strip $(WALLPAPER_BOTTOM))
ENABLE_ATA      := $(strip $(ENABLE_ATA))
ENABLE_AUDIO    := $(strip $(ENABLE_AUDIO))
ENABLE_NETWORK  := $(strip $(ENABLE_NETWORK))
PREFIX          := $(strip $(PREFIX))
LIMINE_DIR      := $(strip $(LIMINE_DIR))
QEMU_MEMORY     := $(strip $(QEMU_MEMORY))
QEMU_CPUS       := $(strip $(QEMU_CPUS))

# --- Tools -------------------------------------------------------------------
# (plain ?= would not override make's builtin CC/AS defaults)
ifeq ($(origin CC),default)
CC      = $(PREFIX)gcc
endif
ifeq ($(origin AS),default)
AS      = $(PREFIX)as
endif
XORRISO ?= xorriso

# --- Layout ------------------------------------------------------------------
BUILD_DIR := build
OBJ_DIR   := $(BUILD_DIR)/obj
GEN_DIR   := $(BUILD_DIR)/generated
ISO_DIR   := $(BUILD_DIR)/isodir
GEN_HDR   := $(GEN_DIR)/os_config.h
KERNEL    := $(BUILD_DIR)/$(OS_NAME_LOWER).bin
ISO       := $(BUILD_DIR)/$(OS_NAME_LOWER).ISO
LIMINE_CFG:= $(BUILD_DIR)/limine.conf
GRUB_CFG  := $(BUILD_DIR)/grub.cfg
ISOVOL   := $(shell printf '%s' '$(OS_NAME_LOWER)' | tr 'a-z' 'A-Z')

# --- Sources -----------------------------------------------------------------
# Everything under src/ is compiled automatically. Drop a new .c file in
# src/<area>/ and it is built -- no Makefile edit needed.
# Exception: src/net/nics.c is an unfinished virtio-net driver fragment that
# was not wired into the build upstream either; it is kept for reference.
SRCS := $(sort $(wildcard src/*/*.c src/*/*/*.c))
SRCS := $(filter-out src/net/nics.c,$(SRCS))
OBJS := $(patsubst src/%.c,$(OBJ_DIR)/%.o,$(SRCS)) $(OBJ_DIR)/boot.o
DEPS := $(OBJS:.o=.d)

# --- Flags (inherited from the upstream build) --------------------------------
CFLAGS  := -m64 -std=gnu99 -ffreestanding -Os -Wall -Wextra -fno-pie \
           -fno-stack-protector -fno-asynchronous-unwind-tables \
           -mno-red-zone -mgeneral-regs-only -fomit-frame-pointer \
           -fmerge-all-constants -fno-unwind-tables -fno-exceptions \
           -mcmodel=kernel -I$(GEN_DIR) -Iinclude -MMD -MP
ASFLAGS := --64
LDFLAGS := -m64 -ffreestanding -Os -nostdlib -no-pie \
           -Wl,-m,elf_x86_64 -Wl,-gc-sections -Wl,--strip-all

.PHONY: all kernel ISO clean run run-serial run-uefi config verify help __config
all: ISO

kernel: $(KERNEL)

ISO: $(ISO)

# --- Generated configuration header -------------------------------------------
# Regenerated whenever config.mk or a command-line override changes the
# values; the file is only replaced if its contents actually differ, so
# objects are not needlessly rebuilt (the __config prerequisite merely
# forces the comparison to run on every make invocation).
$(GEN_HDR): __config | $(GEN_DIR)
	@{ \
	  printf '%s\n' \
	    '/* os_config.h -- GENERATED by make from config.mk. DO NOT EDIT. */' \
	    '#ifndef OS_CONFIG_H' \
	    '#define OS_CONFIG_H' \
	    '#define OS_NAME "$(OS_NAME)"' \
	    '#define OS_NAME_LOWER "$(OS_NAME_LOWER)"' \
	    '#define OS_VERSION "$(OS_VERSION)"' \
	    '#define OS_CODENAME "$(OS_CODENAME)"' \
	    '#define OS_VENDOR "$(OS_VENDOR)"' \
	    '#define OS_HOSTNAME "$(OS_HOSTNAME)"' \
	    '#define OS_DEFAULT_USER "$(OS_DEFAULT_USER)"' \
	    '#define OS_SHELL_NAME "$(OS_SHELL_NAME)"' \
	    '#define KERNEL_AUTHOR "$(KERNEL_AUTHOR)"' \
	    '#define KERNEL_CREDIT "Kernel created by " KERNEL_AUTHOR' \
	    '#define OS_WALLPAPER_TOP $(WALLPAPER_TOP)u' \
	    '#define OS_WALLPAPER_BOTTOM $(WALLPAPER_BOTTOM)u' \
	    '#define CONFIG_ENABLE_ATA $(ENABLE_ATA)' \
	    '#define CONFIG_ENABLE_AUDIO $(ENABLE_AUDIO)' \
	    '#define CONFIG_ENABLE_NETWORK $(ENABLE_NETWORK)' \
	    '#endif /* OS_CONFIG_H */'; \
	} > $@.tmp
	@if cmp -s $@.tmp $@; then rm -f $@.tmp; else mv $@.tmp $@; \
	  echo "  GEN   $@  ($(OS_NAME) $(OS_VERSION) \"$(OS_CODENAME)\")"; fi

$(GEN_DIR):
	mkdir -p $@

# --- Compilation ---------------------------------------------------------------
$(OBJ_DIR)/%.o: src/%.c $(GEN_HDR)
	@mkdir -p $(@D)
	@echo "  CC    $<"
	@$(CC) $(CFLAGS) -c $< -o $@

$(OBJ_DIR)/boot.o: boot.s
	@mkdir -p $(@D)
	@echo "  AS    $<"
	@$(AS) $(ASFLAGS) $< -o $@

$(KERNEL): $(OBJS) linker.ld
	@echo "  LD    $@"
	@$(CC) -T linker.ld -o $@ $(LDFLAGS) $(OBJS) -lgcc
	@echo "  -> kernel: $@ ($$(du -h $@ | cut -f1))"

-include $(DEPS)

# --- Bootloader configuration (generated from *.in templates) ------------------
$(LIMINE_CFG): limine.conf.in config.mk Makefile
	@mkdir -p $(BUILD_DIR)
	@echo "  GEN   $@"
	sed -e 's|@OS_NAME@|$(OS_NAME)|g' \
	    -e 's|@OS_NAME_LOWER@|$(OS_NAME_LOWER)|g' \
	    -e 's|@BOOT_TIMEOUT@|$(BOOT_TIMEOUT)|g' \
	    -e 's|@BOOT_RESOLUTION@|$(BOOT_RESOLUTION)|g' $< > $@

$(GRUB_CFG): grub.cfg.in config.mk Makefile
	@mkdir -p $(BUILD_DIR)
	@echo "  GEN   $@"
	sed -e 's|@OS_NAME@|$(OS_NAME)|g' \
	    -e 's|@OS_NAME_LOWER@|$(OS_NAME_LOWER)|g' \
	    -e 's|@BOOT_TIMEOUT@|$(BOOT_TIMEOUT)|g' $< > $@

# --- Bootable ISO (Limine, hybrid BIOS + UEFI -- same layout as upstream) ------
$(ISO): $(KERNEL) $(LIMINE_CFG) $(GRUB_CFG)
	@chmod +x $(LIMINE_DIR)/limine 2>/dev/null || true
	rm -rf $(ISO_DIR)
	mkdir -p $(ISO_DIR)/boot/limine $(ISO_DIR)/boot/grub $(ISO_DIR)/EFI/BOOT
	cp $(KERNEL) $(ISO_DIR)/boot/$(OS_NAME_LOWER).bin
	cp $(LIMINE_CFG) $(ISO_DIR)/boot/limine/limine.conf
	cp $(LIMINE_CFG) $(ISO_DIR)/limine.conf
	cp $(LIMINE_CFG) $(ISO_DIR)/boot/limine/limine.cfg
	cp $(LIMINE_CFG) $(ISO_DIR)/limine.cfg
	cp $(LIMINE_CFG) $(ISO_DIR)/boot/limine.cfg
	cp $(GRUB_CFG) $(ISO_DIR)/boot/grub/grub.cfg
	cp $(LIMINE_DIR)/limine-bios.sys $(ISO_DIR)/boot/limine/
	cp $(LIMINE_DIR)/limine-bios-cd.bin $(ISO_DIR)/boot/limine/
	cp $(LIMINE_DIR)/limine-uefi-cd.bin $(ISO_DIR)/boot/limine/
	cp $(LIMINE_DIR)/BOOTX64.EFI $(ISO_DIR)/EFI/BOOT/BOOTX64.EFI
	cp $(LIMINE_DIR)/BOOTIA32.EFI $(ISO_DIR)/EFI/BOOT/BOOTIA32.EFI
	@echo "  ISO   $@"
	$(XORRISO) -as mkisofs -R -r -J -V "$(ISOVOL)" \
		-b boot/limine/limine-bios-cd.bin \
		-no-emul-boot -boot-load-size 4 -boot-info-table \
		--efi-boot boot/limine/limine-uefi-cd.bin \
		-efi-boot-part --efi-boot-image --protective-msdos-label \
		$(ISO_DIR) -o $@
	$(LIMINE_DIR)/limine bios-install $@
	@echo "  -> ISO: $@ ($$(du -h $@ | cut -f1)) -- boot it with: make run"

# --- Run in QEMU ----------------------------------------------------------------
QEMU_FLAGS := -m $(QEMU_MEMORY) -smp $(QEMU_CPUS) -cpu host \
              -cdrom $(ISO) -boot order=d -vga std \
              -audiodev pa,id=snd0 -device intel-hda -device hda-duplex,audiodev=snd0 \
              -netdev user,id=net0 -device e1000,netdev=net0
OVMF ?= /usr/share/OVMF/OVMF_CODE.fd

run: $(ISO)
	$(QEMU) $(QEMU_FLAGS) -enable-kvm -display gtk,zoom-to-fit=on

run-serial: $(ISO)
	$(QEMU) $(QEMU_FLAGS) -serial stdio -display none

run-uefi: $(ISO)
	$(QEMU) $(QEMU_FLAGS) -enable-kvm -bios $(OVMF) -display gtk,zoom-to-fit=on

# --- Housekeeping -----------------------------------------------------------------
clean:
	rm -rf $(BUILD_DIR)

config:
	@echo "OS_NAME         = $(OS_NAME)"
	@echo "OS_NAME_LOWER   = $(OS_NAME_LOWER)  (kernel: $(KERNEL), ISO: $(ISO))"
	@echo "OS_VERSION      = $(OS_VERSION)  (codename: $(OS_CODENAME))"
	@echo "OS_VENDOR       = $(OS_VENDOR)"
	@echo "KERNEL_AUTHOR   = $(KERNEL_AUTHOR)  (kernel credit, please keep)"
	@echo "OS_HOSTNAME     = $(OS_HOSTNAME)"
	@echo "OS_DEFAULT_USER = $(OS_DEFAULT_USER)"
	@echo "ENABLE_ATA      = $(ENABLE_ATA)"
	@echo "ENABLE_AUDIO    = $(ENABLE_AUDIO)"
	@echo "ENABLE_NETWORK  = $(ENABLE_NETWORK)"
	@echo "Edit config.mk to change any of these, then re-run make."

# The stripped base must not reference the old OS name anywhere, and the
# kernel-author credit must survive. This target enforces both.
verify:
	@if grep -rin "sha[r]k" src include boot.s linker.ld Makefile config.mk \
	     limine.conf.in grub.cfg.in 2>/dev/null; then \
	  echo "FAIL: old OS name still referenced (see above)"; exit 1; \
	else echo "OK: no references to the old OS name"; fi
	@if grep -rq "$(KERNEL_AUTHOR)" src include CREDITS.md README.md 2>/dev/null; then \
	  echo "OK: kernel credit for $(KERNEL_AUTHOR) present"; \
	else echo "FAIL: kernel credit missing"; exit 1; fi
	@if grep -rIn "doom\|flappybird\|fnaf\|plugin_manager\|spkg" src include 2>/dev/null; then \
	  echo "FAIL: bundled-app references remain (see above)"; exit 1; \
	else echo "OK: no bundled apps / plugin system referenced"; fi

help:
	@echo "Targets: all (default) | kernel | ISO | run | run-serial | run-uefi"
	@echo "         clean | config | verify | help"
	@echo "Rebrand: edit config.mk (OS_NAME=..., OS_VERSION=..., ...), then make."
